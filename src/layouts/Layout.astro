---
import Header from "../components/Header";
import "../styles/global.css";
import { BASE_URL, data, type SearchItem } from "../data/data";

interface Props {
  title?: string;
}

const { title } = Astro.props;

// do prohlizece posilame jen to, co vyhledavani potrebuje
// name, year, url
const searchItems: SearchItem[] = data.categories.flatMap((category) =>
  category.computers.map((computer) => ({
    name: computer.name,
    year: computer.year,
    url: `${BASE_URL}${category.generation}/${computer.slug}`,
  })),
);
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${BASE_URL}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} | Historie počítačů` : "Historie počítačů"}</title>
  </head>
  <body>
    <Header client:load searchItems={searchItems} />
    <slot />
  </body>
</html>
