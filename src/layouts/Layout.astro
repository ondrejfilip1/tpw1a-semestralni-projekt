---
import Header from "../components/Header";
import "../styles/global.css";
import { BASE_URL, data, type SearchItem } from "../data/data";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "Online průvodce vývojem výpočetní techniky od Analytického stroje až po kvantové procesory. Generace počítačů, časová osa a články se zdroji.",
} = Astro.props;

// do prohlizece posilame jen to, co vyhledavani potrebuje
// name, year, url
const searchItems: SearchItem[] = data.categories.flatMap((category) =>
  category.computers.map((computer) => ({
    name: computer.name,
    year: computer.year,
    url: `${BASE_URL}${category.generation}/${computer.slug}`,
  })),
);
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${BASE_URL}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} | Historie počítačů` : "Historie počítačů"}</title>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:inset-x-0 focus:top-0 focus:z-30 focus:flex focus:h-20 focus:items-center focus:justify-center focus:bg-primary focus:-outline-offset-4"
      >Přeskočit na obsah</a
    >
    <Header client:load searchItems={searchItems} currentPath={Astro.url.pathname} />
    <slot />
  </body>
</html>
