---
import Layout from "../../layouts/Layout.astro";
import {
  BASE_URL,
  data,
  type Category,
  type Computer,
} from "../../data/data";
import { ChevronLeft } from "lucide-react";

export function getStaticPaths() {
  return data.categories.flatMap((category) =>
    category.computers.map((computer) => ({
      params: {
        generation: category.generation,
        computer: computer.slug,
      },
      props: { category, computer },
    })),
  );
}

interface Props {
  category: Category;
  computer: Computer;
}

const { category, computer } = Astro.props;
---

<Layout title={computer.name}>
  <main class="md:px-wider px-base container flex flex-col gap-wide mb-section">
    <div
      class="flex lg:flex-row flex-col gap-wide min-h-[80vh] items-center lg:justify-start justify-center"
    >
      <div class="lg:w-1/2">
        <a
          href={`${BASE_URL}${category.generation}`}
          class="flex items-center text-primary sm:text-lead text-body mb-wide"
          ><ChevronLeft />Zpět do generace</a
        >
        <p class="text-tertiary sm:text-lead text-body">{computer.year}</p>
        <h1 class="heading-2 font-display">{computer.article.heading}</h1>
      </div>
      <img
        src={`${BASE_URL}${computer.image.src}`}
        alt={computer.image.alt}
        style={{ viewTransitionName: `computer-${computer.slug}` }}
        class="lg:max-h-124 max-h-84 w-full lg:w-1/2 object-contain"
      />
    </div>
    <div
      class="sm:text-lead text-body text-justify text-primary flex flex-col gap-base [&_h3]:text-subheading [&_h3]:text-tertiary [&_h3]:mt-base"
      set:html={computer.article.article}
    />
    {
      computer.article.sources.length > 0 && (
        <section class="flex flex-col gap-tight">
          <h3 class="text-subheading text-tertiary">Zdroje</h3>
          <ul class="list-disc pl-relaxed sm:text-lead text-body">
            {computer.article.sources.map((source) => (
              <li>
                <a
                  href={source.link}
                  target="_blank"
                  rel="noopener"
                  class="underline"
                >
                  {source.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Layout>
