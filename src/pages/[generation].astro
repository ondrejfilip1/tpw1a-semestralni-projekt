---
import Layout from "../layouts/Layout.astro";
import { data, type Category } from "../data/data";
import ComputerCollection from "../components/ComputerCollection";
import Heading from "../components/Heading";

export function getStaticPaths() {
  return data.categories.map((item) => ({
    params: { generation: item.generation },
    props: { category: item },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<Layout title={category.name}>
  <main id="main" class="md:px-wider px-base">
    <ComputerCollection
      client:load
      computers={category.computers}
      generation={category.generation}
    >
      <Heading client:load text={category.name} />
      <div
        class="sm:text-lead text-body indent-wider max-w-2xl text-justify text-primary"
        set:html={category.description}
      />
    </ComputerCollection>
  </main>
</Layout>
