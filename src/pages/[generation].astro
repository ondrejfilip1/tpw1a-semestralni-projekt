---
import Layout from "../layouts/Layout.astro";
import { BASE_URL, data, type Category } from "../data/data";
import { ChevronLeft } from "lucide-react";
import ComputerItem from "../components/ComputerItem";
import Heading from "../components/Heading";

export function getStaticPaths() {
  return data.categories.map((item) => ({
    params: { generation: item.generation },
    props: { category: item },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<Layout title={category.name}>
  <main class="md:px-wider px-base">
    <div class="min-h-screen flex flex-col justify-center gap-wide">
      <a href={BASE_URL} class="flex items-center text-primary sm:text-lead text-body"
        ><ChevronLeft />Zpět na úvod</a
      >
      <Heading client:load text={category.name} />
      <div
        class="sm:text-lead text-body indent-wider max-w-2xl text-justify text-primary"
        set:html={category.description}
      />
    </div>

    <section class="flex gap-section flex-col mb-section">
      {
        category.computers.map((item, index) => {
          // karty zmeni poradi, kdyz jsou liche
          const shouldFlip: boolean = index % 2 == 1;

          return <ComputerItem
              computer={item}
              shouldFlip={shouldFlip}
              generation={category.generation}
            />;
        })
      }
    </section>
  </main>
</Layout>
